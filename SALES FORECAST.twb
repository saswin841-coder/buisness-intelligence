      <aliases enabled='yes' />
      <column caption='Predicted Sales' datatype='real' name='[Calculation_0082843186925568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales]), -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Latest Predicted Sales' datatype='real' name='[Calculation_0082843187257345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST() = 0 THEN&#10;    WINDOW_AVG(SUM([Sales]), -2, 0)&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales Growth %' datatype='real' name='[Calculation_0082843187580930]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1))&#10;/&#10;ABS(LOOKUP(SUM([Sales]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Latest Growth %' datatype='real' name='[Calculation_0082843187863555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST() = 0 THEN&#10;    (SUM([Sales]) - LOOKUP(SUM([Sales]), -1))&#10;    /&#10;    ABS(LOOKUP(SUM([Sales]), -1))&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Monthly Sales Growth %' datatype='real' name='[Calculation_0082843190599684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1))&#10;/&#10;ABS(LOOKUP(SUM([Sales]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
